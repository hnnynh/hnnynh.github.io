---
type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type Props = {
  headings: Heading[];
};

const { headings } = Astro.props;
const visibleHeadings = headings.filter((heading) => heading.depth > 1);
const minDepth = Math.min(...visibleHeadings.map((heading) => heading.depth));
---

{
  visibleHeadings.length > 0 ? (
    <aside class="hidden xl:block xl:sticky xl:top-20 xl:max-h-[calc(100vh-6rem)] xl:self-start xl:overflow-y-auto">
      <nav aria-label="On this page">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-base-500 dark:text-base-400">
          On this page
        </h2>
        <ol class="mt-4 space-y-2 border-l border-base-200 pl-4 dark:border-base-800">
          {visibleHeadings.map((heading) => (
            <li
              style={`padding-left: ${(heading.depth - minDepth) * 0.75}rem`}
            >
              <a
                href={`#${heading.slug}`}
                class="block text-sm leading-5 text-base-600 hover:text-base-950 dark:text-base-400 dark:hover:text-base-50"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>
  ) : null
}
