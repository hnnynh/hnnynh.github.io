---
interface Props {
  url: string;
}

const { url } = Astro.props;
const applauseAssetBase = "/vendor/applause-button";
---

<link
  rel="stylesheet"
  href={`${applauseAssetBase}/applause-button.css`}
  integrity="sha384-kwNWgXTxe+yV8n1kL+LTKug5OGw0eNNp58jyoaLf9mnZi5AkFShr/Qw7qZACWFUV"
/>
<script
  is:inline
  src={`${applauseAssetBase}/applause-button.js`}
  integrity="sha384-pZ9kL7Uf7MfDXwswB58pbHhOD6lIkuM3+XaBAtVUy4La+yY/oKpopaXPR2UTD3Ud"
></script>

<applause-button class="post-applause" color="#d8a7b1" url={url} />

<style is:global>
  .post-applause {
    display: inline-block;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    color: #d8a7b1;
  }

  .post-applause .style-root {
    --main-color: #d8a7b1;
  }

  .post-applause .shockwave {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .post-applause .shockwave::after {
    content: "♥";
    font-size: 1.1rem;
    line-height: 1;
  }

  .post-applause svg {
    display: none;
  }

  .post-applause .clap-count {
    font-size: 0.75rem;
  }
</style>
