---
import { BASE } from "../config.ts";

type Props = {
  posts: Array<any>;
};

const { posts } = Astro.props;

const categorizedPosts = new Map<string, Array<any>>();

posts.forEach((post: any) => {
  const categories = post.data.categories?.length
    ? post.data.categories
    : post.data.category
      ? [post.data.category]
      : ["Uncategorized"];

  categories.forEach((category: string) => {
    const groupedPosts = categorizedPosts.get(category) ?? [];
    groupedPosts.push(post);
    categorizedPosts.set(category, groupedPosts);
  });
});

const categories = Array.from(categorizedPosts).sort(([a], [b]) =>
  a.localeCompare(b)
);
---

<aside
  class="mb-8 lg:mb-0 lg:sticky lg:top-20 lg:max-h-[calc(100vh-6rem)] lg:self-start lg:overflow-y-auto"
>
  <nav aria-label="All posts">
    <h2
      class="text-xs font-semibold uppercase tracking-wide text-base-500 dark:text-base-400"
    >
      All posts
    </h2>
    <div
      class="mt-4 space-y-6 border-l border-base-200 pl-4 dark:border-base-800"
    >
      {
        categories.map(([category, categoryPosts]) => (
          <section>
            <h3 class="text-sm font-semibold text-base-900 dark:text-base-100">
              {category}
            </h3>
            <ol class="mt-3 space-y-2">
              {categoryPosts.map((post: any) => (
                <li>
                  <a
                    href={BASE + `/posts/${post.id}/`}
                    class="block text-sm leading-5 text-base-600 hover:text-base-950 dark:text-base-400 dark:hover:text-base-50"
                  >
                    {post.data.title}
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </nav>
</aside>
