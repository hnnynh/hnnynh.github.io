---
import { type CollectionEntry, render } from "astro:content";
import BaseLayout from "$layouts/BaseLayout.astro";
import BlogPost from "$layouts/BlogPost.astro";
import Header from "$components/Header.astro";
import Footer from "$components/Footer.astro";
import { Image } from "astro:assets";
import FormattedDate from "$components/FormattedDate.astro";
import { getBlogPosts } from "src/utils";
import Tag from "$components/Tag.astro";
import {
  AUTHOR_NAME,
  AUTHOR_URL,
  SHOW_IMAGES,
  SITE_NAME,
} from "../../config.ts";
import PostSidebar from "$components/PostSidebar.astro";
import PostToc from "$components/PostToc.astro";
import ApplauseButton from "$components/ApplauseButton.astro";

export async function getStaticPaths() {
  const posts = await getBlogPosts(true);
  return posts.map((post: any) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content, headings } = await render(post);
const posts = await getBlogPosts();
const postUrl = new URL(Astro.url.pathname, Astro.site).toString();
const postImageUrl = new URL(`/open-graph/${post.id}.png`, Astro.site).toString();
const blogPostingJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  url: postUrl,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": postUrl,
  },
  image: postImageUrl,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate && {
    dateModified: post.data.updatedDate.toISOString(),
  }),
  author: {
    "@type": "Person",
    name: AUTHOR_NAME,
    url: AUTHOR_URL,
  },
  ...(post.data.tags?.length && { keywords: post.data.tags.join(", ") }),
};

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif}"
);
const replacedHero = post.data.heroImage?.replace("../..", "/src");
if (replacedHero && !images[replacedHero])
  throw new Error(
    `"${post.data.heroImage}" does not exist in glob: "src/assets/**/*.{jpeg,jpg,png,gif}"`
  );
---

<BaseLayout
  {...post.data}
  title={`${post.data.title} | ${SITE_NAME}`}
  image={post.id + ".png"}
  ogType="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
  jsonLd={blogPostingJsonLd}
>
  <Header active="blog" />

  <main class="w-full mt-4 px-4 sm:px-6 lg:px-8">
    <div
      class="lg:grid lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-8 xl:grid-cols-[15rem_minmax(0,1fr)_14rem]"
    >
      <PostSidebar {posts} />

      <article class="max-w-4xl">
        {
          replacedHero && post.data.hideHero !== true && SHOW_IMAGES ? (
            <Image
              src={images[replacedHero]()}
              alt={post.data.title}
              class="w-full h-80 object-cover rounded-xl shadow border border-base-400 dark:border-base-700"
            />
          ) : null
        }
        <BlogPost>
          <div
            class="flex mt-4 gap-4 text-xs flex-col md:flex-row items-start md:items-center"
          >
            <div class="shrink-0 inline-flex items-center gap-1.5">
              <span>
                Published <FormattedDate date={post.data.pubDate} />
              </span>
              {
                post.data.updatedDate && (
                  <>
                    <span aria-hidden="true">·</span>
                    <span>
                      Updated <FormattedDate date={post.data.updatedDate} />
                    </span>
                  </>
                )
              }
            </div>
            <div class="flex gap-2 flex-wrap md:ml-auto md:justify-end">
              {post.data.tags?.map((tag: string) => <Tag {tag} />)}
            </div>
          </div>

          <div class="mt-4 flex items-start gap-3">
            <h1 class="m-0 min-w-0 flex-1">{post.data.title}</h1>
            <ApplauseButton url={postUrl} />
          </div>
          <Content />

        </BlogPost>
      </article>

      <PostToc {headings} />
    </div>
  </main>
  <Footer />
</BaseLayout>
