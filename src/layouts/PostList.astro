---
import { SITE_TITLE, SITE_DESCRIPTION } from "../config.ts";

import Footer from "$components/Footer.astro";
import Header from "$components/Header.astro";
import BaseLayout from "$layouts/BaseLayout.astro";
import BlogEntry from "$components/BlogEntry.astro";

import Pagination from "$components/Pagination.astro";
import ProseWrapper from "./ProseWrapper.astro";
import BigBlogEntry from "$components/BigBlogEntry.astro";
import PostSidebar from "$components/PostSidebar.astro";

type Props = {
  posts: Array<any>;
  totalPages: number;
  currentPage: number;
  tag?: string;
  showFeatured?: boolean;
  sidebarPosts?: Array<any>;
  jsonLd?: Record<string, unknown>;
};

const {
  posts,
  totalPages,
  currentPage,
  tag,
  showFeatured,
  sidebarPosts,
  jsonLd,
} = Astro.props;
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  jsonLd={jsonLd}
>
  <Header active="blog" />
  <main class="w-full mt-4 px-4 sm:px-6 lg:px-8">
    <div
      class:list={[
        sidebarPosts?.length
          ? "lg:grid lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-8 xl:grid-cols-[15rem_minmax(0,1fr)]"
          : "max-w-2xl lg:max-w-3xl mx-auto",
      ]}
    >
      {
        sidebarPosts?.length ? (
          <PostSidebar posts={sidebarPosts} />
        ) : null
      }

      <div class="max-w-3xl">
        <ProseWrapper class="pb-4">
          <slot />
        </ProseWrapper>

        {
          showFeatured && posts[0] ? (
            <BigBlogEntry {...posts[0].data} slug={posts[0].id} />
          ) : null
        }
        <div class="my-10 space-y-12 max-w-3xl">
          {
            posts.map((post: any, index: number) =>
              index > 0 || !showFeatured ? (
                <BlogEntry {...post.data} slug={post.id} />
              ) : null
            )
          }
        </div>

        {
          totalPages > 1 ? (
            <Pagination current={currentPage} total={totalPages} {tag} />
          ) : null
        }
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
