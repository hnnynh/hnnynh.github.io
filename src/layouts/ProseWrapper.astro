---
import { colorBaseClasses, colorAccentClasses } from "src/colors";
import { ACCENT_COLOR, BASE_COLOR } from "../config.ts";

const { class: className } = Astro.props;
---

<div
  class:list={[
    "prose prose-img:mx-auto prose-img:block prose-img:rounded-xl dark:prose-invert prose-a:no-underline",
    "prose-ul:my-3 prose-ol:my-3 prose-li:my-1",
    "prose-h1:px-2",
    "prose-h2:border-b prose-h2:border-base-300 prose-h2:px-2 prose-h2:pb-2 dark:prose-h2:border-base-700",
    "prose-h3:border-l-4 prose-h3:border-base-400 prose-h3:pl-3 prose-h3:pr-2 dark:prose-h3:border-base-600",
    "prose-h4:px-2 prose-h4:font-bold",
    "prose-inline-code:bg-base-100 dark:prose-inline-code:bg-base-800 prose-inline-code:p-1 prose-inline-code:rounded-md",
    colorBaseClasses[BASE_COLOR],
    colorAccentClasses[ACCENT_COLOR],
    className,
  ]}
>
  <slot />
</div>
